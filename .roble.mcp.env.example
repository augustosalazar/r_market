# Configuración del servidor MCP de Roble para ESTE proyecto.
#
# Cópialo como `.roble.mcp.env` y añade `.roble.mcp.env` al .gitignore:
# lleva un token dentro. El MCP avisa si se te olvida.
#
# Se busca desde el directorio de trabajo hacia arriba, así que basta con
# tenerlo en la raíz del proyecto aunque abras el editor en una subcarpeta.
# Lo que ponga aquí gana sobre lo que haya exportado en el shell, para que
# trabajar en dos proyectos a la vez no se cruce.

# Servidor de test. Ojo: es roble-api..., no roble... (ese sirve la consola).
ROBLE_BASE_URL=https://roble-api.test-openlab.uninorte.edu.co

# El identificador del proyecto en la consola.
ROBLE_CONTRACT_ID=miproyecto_ab12cd34ef

# Consola → Configuración → Tokens de acceso. Se muestra una sola vez.
# Elige "solo lectura" salvo que quieras que el agente cree tablas.
ROBLE_TOKEN=roble_pat_...

# Opcional: dónde guardar la memoria del plan. Por omisión, `roble.schema.json`
# junto a este archivo.
# ROBLE_SCHEMA_FILE=./roble.schema.json
