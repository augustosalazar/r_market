# Copia este archivo como .env y llena los valores. El .env no va al
# repositorio: cada quien apunta a su propio proyecto.
#
# Expo lee las variables EXPO_PUBLIC_* al arrancar `npx expo start`. Si las
# cambias, reinicia con `npx expo start --clear`.

# El host del API de Roble. Ojo: es roble-api..., no roble... (ese sirve la consola).
EXPO_PUBLIC_ROBLE_BASE_URL=https://roble-api.test-openlab.uninorte.edu.co

# El proyecto de Roble. Se copia de la consola: es lo que aparece en la URL,
# /dashboard/project/<esto>
EXPO_PUBLIC_ROBLE_CONTRACT_ID=
